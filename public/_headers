# Security headers for Netlify and Cloudflare Pages (Vercel uses vercel.json).
# The main Content-Security-Policy is a <meta> tag generated at build time;
# frame-ancestors only works as an HTTP header, so it is set here.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
